const menuBtn = document.getElementById("menuBtn");
const navLinks = document.getElementById("navLinks");

menuBtn.addEventListener("click", () => {
  navLinks.classList.toggle("show");
});

document.querySelectorAll(".nav-links a").forEach(link => {
  link.addEventListener("click", () => navLinks.classList.remove("show"));
});

const checks = document.querySelectorAll(".security-check");
const progressBar = document.getElementById("progressBar");
const progressText = document.getElementById("progressText");

function updateProgress() {
  const completed = [...checks].filter(c => c.checked).length;
  const percent = (completed / checks.length) * 100;
  progressBar.style.width = percent + "%";
  progressText.textContent = `${completed} de ${checks.length} prácticas seleccionadas`;
}
checks.forEach(check => check.addEventListener("change", updateProgress));
